/* CW application layout (ui/common.tcss holds the shared parts), after HAMRLOG's.
   Vertical stack: status line, main window (flexible), detail window, entry
   window, footer. Each window has its own frame; only the main one grows, so
   the entry stays at the same place whatever the terminal size. */

#main-frame,
#detail {
    border: round $primary-darken-2;
    border-title-color: $accent;
    border-title-align: left;
}

#main-frame {
    height: 1fr;
    min-height: 8;
    padding: 0;
}

#rx {
    height: 1fr;
    padding: 0 1;
    background: $surface;
}

/* The skimmer takes the receive pane's place in the same frame. */
#skim {
    height: 1fr;
    border: none;
    background: $surface;
    overflow-x: hidden;
}

#skim > .datatable--header {
    background: $panel;
    color: $text;
    text-style: bold;
}

#skim > .datatable--cursor,
#skim > .datatable--hover {
    background: $primary;
    color: $text;
    text-style: bold;
}

/* Plain-language meaning of the decoded text, under the receive window. */
#meaning-frame {
    height: 9;
    border: round $primary-darken-2;
    border-title-color: $accent;
    border-title-align: left;
}

#meaning {
    height: 1fr;
    padding: 0 1;
    background: $surface;
}

/* Three lines of detail inside the frame. */
#detail {
    height: 5;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    background: $surface;
}

/* ------------------------------------------------------ channels view ---- */

Channels#chan-title {
    height: 1;
    background: $primary-darken-3;
    padding: 0 1;
}

#chan-frame,
#chan-detail {
    border: round $primary-darken-2;
    border-title-color: $accent;
    border-title-align: left;
}

#chan-frame {
    height: 1fr;
    min-height: 6;
}

#chan-table {
    height: 1fr;
    border: none;
    background: $surface;
}

#chan-table > .datatable--header {
    background: $panel;
    text-style: bold;
}

#chan-table > .datatable--cursor {
    background: $primary;
    text-style: bold;
}

#chan-detail {
    height: 2fr;
    padding: 0 1;
}

#chan-hint {
    height: 1;
    background: $panel;
}
