/* Rig view: frequency and meters on top, the scope in the middle, the front panel below. */

#top {
    height: 8;
}

#vfo-frame {
    width: 1fr;
    height: 8;
    padding: 0 1;
    background: $surface;
}

#frequency {
    width: auto;
    color: $warning;
    text-style: bold;
}

#vfo {
    height: 2;
}

#meters {
    width: 46;
    height: 8;
    padding: 0 1;
    background: $surface;
}

#scope {
    height: 1fr;
    min-height: 10;
}

#panel {
    height: auto;
    max-height: 14;
    background: $surface;
}
