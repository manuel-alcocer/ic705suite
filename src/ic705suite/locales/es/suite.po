msgid "antenna: remote control on"
msgstr "antena: control remoto encendido"

msgid "the phone can sweep; SWR sweeps allowed"
msgstr "el móvil puede barrer; barridos de ROE permitidos"

msgid "the phone only watches; no SWR sweeps"
msgstr "el móvil solo mira; sin barridos de ROE"

