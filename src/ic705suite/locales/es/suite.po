msgid ""
"/c CALL [v DIGI …]   connect this channel to CALL (via digipeaters)\n"
"/d                   disconnect this channel\n"
"/ch N                go to channel N (also F1-F8; 0 is the monitor)\n"
"/ui DEST text        send an unconnected UI frame\n"
"/clear               clear this channel's window (also Ctrl+L)\n"
"/retry               reach the TNC again now\n"
"/tnc                 the TNC: settings and what Direwolf says (/tnc restart)\n"
"/qrg 144.800         tune the IC-705 for packet (FM-D), when it is the radio\n"
"/quit                back to the dashboard (also Ctrl+Q)\n"
"//text               send a line starting with / (connected, /EX and any other\n"
"                     line that is not a command here go to the station as typed)"
msgstr ""
"/c IND [v DIGI …]    conecta este canal con IND (por digirrepetidores)\n"
"/d                   desconecta este canal\n"
"/ch N                va al canal N (también F1-F8; el 0 es el monitor)\n"
"/ui DEST texto       envía una trama UI sin conexión\n"
"/clear               limpia la ventana de este canal (también Ctrl+L)\n"
"/retry               vuelve a buscar el TNC ahora\n"
"/tnc                 el TNC: su configuración y lo que dice Direwolf (/tnc restart)\n"
"/qrg 144.800         sintoniza la IC-705 para packet (FM-D), cuando es la radio\n"
"/quit                vuelve al panel (también Ctrl+Q)\n"
"//texto              envía una línea que empieza por / (conectado, /EX y cualquier\n"
"                     otra línea que no sea un comando de aquí van a la estación tal cual)"

