# Spanish translations of the graphical client (ic705suite --gui).
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "the graphical client needs PySide6 and qasync (pip install 'ic705suite[gui]'): {error}"
msgstr "el cliente gráfico necesita PySide6 y qasync (pip install 'ic705suite[gui]'): {error}"

msgid "{name}: not in the graphical client yet; in the terminal: ic705suite {app}"
msgstr "{name}: aún no está en el cliente gráfico; en el terminal: ic705suite {app}"

msgid "Noise sweep (RX)"
msgstr "Barrido de ruido (RX)"

msgid "SWR sweep (TX)"
msgstr "Barrido de ROE (TX)"

msgid "Save position"
msgstr "Guardar posición"

msgid "Stop/Back"
msgstr "Parar/Volver"

msgid "use it"
msgstr "usarla"

msgid "new"
msgstr "nueva"

msgid "edit"
msgstr "editar"

msgid "delete"
msgstr "borrar"

msgid "CB Mode"
msgstr "Modo CB"

msgid "To the 27 MHz Citizens Band, on the channel last used there; again, back to where the dial was"
msgstr "A la Banda Ciudadana de 27 MHz, en el último canal usado; otra vez, de vuelta a donde estaba el dial"

msgid "The CB channel (-- between channels); a double click: type one, 1 to 40, Enter tunes, Esc leaves it"
msgstr "El canal de CB (-- entre canales); doble clic: escribe uno, del 1 al 40; Intro sintoniza, Esc lo deja como estaba"
