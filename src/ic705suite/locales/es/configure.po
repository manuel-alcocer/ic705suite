# Spanish translations of ic705suite --configure / --show-config (the installers' questions).
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "That does not look like a callsign (for example EA7XYZ or EA7XYZ/P)"
msgstr "Eso no parece un indicativo (por ejemplo EA7XYZ o EA7XYZ/P)"

msgid "It cannot be empty"
msgstr "No puede quedar vacío"

msgid "Language"
msgstr "Idioma"

msgid "Connection"
msgstr "Conexión"

msgid "Transmission"
msgstr "Transmisión"

msgid "Enter keeps the current one"
msgstr "Intro conserva la actual"

msgid "Enter leaves it empty"
msgstr "Intro la deja vacía"

msgid "[Y/n]"
msgstr "[S/n]"

msgid "[y/N]"
msgstr "[s/N]"

msgid "Your callsign"
msgstr "Tu indicativo"

msgid "How to reach the radio: lan (WiFi/Ethernet), sim (simulator), none (no radio: a core for packet only) or server (through another machine's core)"
msgstr "Cómo llegar al equipo: lan (WiFi/Ethernet), sim (simulador), none (sin equipo: un core solo para packet) o server (a través del core de otra máquina)"

msgid "Transmission stays off until the antenna SWR is right for your bands."
msgstr "Deja la transmisión apagada hasta que la ROE de la antena esté bien en tus bandas."

msgid "Enable transmission?"
msgstr "¿Activar la transmisión?"

msgid "The settings will be:"
msgstr "La configuración quedará así:"

msgid "automatic ({language})"
msgstr "automático ({language})"

msgid "Radio address"
msgstr "Dirección del equipo"

msgid "User"
msgstr "Usuario"

msgid "Password"
msgstr "Contraseña"

msgid "enabled"
msgstr "activada"

msgid "disabled"
msgstr "desactivada"

msgid "Settings in {path}:"
msgstr "Configuración en {path}:"

msgid "Enter keeps each value as it is."
msgstr "Intro conserva cada valor tal como está."

msgid "On the IC-705: MENU > SET > WLAN Set (Connection Status shows its address; Remote Settings, its Network User1)."
msgstr "En el IC-705: MENU > SET > WLAN Set (Connection Status muestra su dirección; Remote Settings, su Network User1)."

msgid "Radio address (IP or name)"
msgstr "Dirección del equipo (IP o nombre)"

msgid "Network user"
msgstr "Usuario de red"

msgid "Network password"
msgstr "Contraseña de red"

msgid "Settings not changed."
msgstr "La configuración no ha cambiado."

msgid "Saved in {path}."
msgstr "Guardada en {path}."

msgid "No settings yet ({path})"
msgstr "Todavía no hay configuración ({path})"

msgid "Choose one of: {options}"
msgstr "Elige una de estas: {options}"

msgid "No terminal to ask at: edit {path} or run ic705suite --configure in a terminal."
msgstr "No hay terminal donde preguntar: edita {path} o ejecuta ic705suite --configure en un terminal."

msgid "ic705suite is already set up in {path}:"
msgstr "ic705suite ya está configurado en {path}:"

msgid "Setting up ic705suite ({path})."
msgstr "Configuración de ic705suite ({path})."

msgid "Save them in {path}?"
msgstr "¿Guardarla en {path}?"

msgid "Graphical client"
msgstr "Cliente gráfico"

msgid "Look of the graphical client (ic705suite --gui): dark, light or auto (as the system)"
msgstr "Aspecto del cliente gráfico (ic705suite --gui): dark (oscuro), light (claro) o auto (como el sistema)"

msgid "Password for switching on the antenna's remote control from the phone (empty: only from the antenna application)"
msgstr "Contraseña para encender desde el móvil el control remoto de la antena (vacía: solo desde la aplicación de antena)"

msgid "Remote control from the phone"
msgstr "Control remoto desde el móvil"

msgid "with a password"
msgstr "con contraseña"

msgid "only from the antenna application"
msgstr "solo desde la aplicación de antena"

msgid "Packet: the Direwolf TNC (its AGWPE port) as host or host:port, on this machine or another (Enter with nothing: no packet)"
msgstr "Packet: el TNC Direwolf (su puerto AGWPE) como máquina o máquina:puerto, en esta o en otra (Intro sin nada: sin packet)"

msgid "Write it as host or host:port, for example raspberrypi.local:8000"
msgstr "Escríbelo como máquina o máquina:puerto, por ejemplo raspberrypi.local:8000"

msgid "Packet callsign, with its SSID"
msgstr "Indicativo para packet, con su SSID"

msgid "A callsign of up to 6 characters and an SSID from 0 to 15, for example EA7XYZ-4"
msgstr "Un indicativo de hasta 6 caracteres y un SSID de 0 a 15, por ejemplo EA7XYZ-4"

msgid "{call} on the TNC at {host}:{port}"
msgstr "{call} en el TNC de {host}:{port}"

msgid "Direwolf is not installed here yet: install it (Debian, Ubuntu, Raspberry Pi OS: apt install direwolf; Windows: its installer) before using packet."
msgstr "Direwolf aún no está instalado aquí: instálalo (Debian, Ubuntu, Raspberry Pi OS: apt install direwolf; Windows: su instalador) antes de usar packet."

msgid "Direwolf's AGWPE port as host or host:port"
msgstr "El puerto AGWPE de Direwolf como máquina o máquina:puerto"

msgid "Found: {device}"
msgstr "Encontrado: {device}"

msgid "No Digirig found plugged in: type its sound card and PTT."
msgstr "No se encuentra ningún Digirig conectado: escribe su tarjeta de sonido y su PTT."

msgid "PTT for Direwolf (e.g. /dev/ttyUSB0 RTS, COM5 RTS, CM108; vox for none)"
msgstr "PTT para Direwolf (p. ej. /dev/ttyUSB0 RTS, COM5 RTS, CM108; vox para ninguno)"

msgid "Sound card for Direwolf (ADEVICE, e.g. plughw:Device,0)"
msgstr "Tarjeta de sonido para Direwolf (ADEVICE, p. ej. plughw:Device,0)"

msgid "{call} with Direwolf started here ({audio}, PTT {ptt})"
msgstr "{call} con Direwolf arrancado aquí ({audio}, PTT {ptt})"

msgid "It needs the snd-aloop virtual sound card, missing now; load it once with: {command}"
msgstr "Necesita la tarjeta de sonido virtual snd-aloop, que ahora falta; cárgala una vez con: {command}"

msgid "Packet TNC: none, agwpe (a Direwolf already running, here or on another machine), direwolf (the suite starts its own here, e.g. with a Digirig) or ic705 (the IC-705 over WiFi, with Direwolf here; Linux)"
msgstr "TNC de packet: none (ninguno), agwpe (un Direwolf que ya funciona, aquí o en otra máquina), direwolf (la suite arranca el suyo aquí, p. ej. con un Digirig) o ic705 (la IC-705 por WiFi, con Direwolf aquí; Linux)"

msgid "The IC-705 transmits packet in FM-D with its DATA1 MOD input on WLAN (the suite sets it; /qrg 144.800 in packet tunes it). Transmitting also needs [rig] tx_enabled."
msgstr "La IC-705 transmite packet en FM-D con su entrada DATA1 MOD en WLAN (la suite la ajusta; /qrg 144.800 en packet la sintoniza). Para transmitir hace falta también [rig] tx_enabled."

msgid "{call} on the IC-705 over WiFi, with Direwolf here"
msgstr "{call} en la IC-705 por WiFi, con Direwolf aquí"

msgid "A BBS on this machine (messages and bulletins for the stations that connect to it)?"
msgstr "¿Una BBS en esta máquina (mensajes y boletines para las estaciones que se conecten)?"

msgid "BBS callsign, with its SSID"
msgstr "Indicativo de la BBS, con su SSID"

msgid "Packet terminal (F7) with a callsign of its own?"
msgstr "¿Terminal de packet (F7) con indicativo propio?"

msgid "no terminal"
msgstr "sin terminal"

msgid "Address of the machine with the radio's core (ic705suite --serve), host or host:port"
msgstr "Dirección de la máquina con el core de la radio (ic705suite --serve), máquina o máquina:puerto"

msgid "Its token ([server] token there)"
msgstr "Su token ([server] token allí)"

msgid "Radio's core"
msgstr "Core de la radio"

msgid "Locator"
msgstr "Locator"

msgid "Your locator (Maidenhead, e.g. IM77; FT8 sends it)"
msgstr "Tu locator (Maidenhead, p. ej. IM77; FT8 lo envía)"

msgid "That does not look like a locator (for example IM77 or IM77AJ)"
msgstr "Eso no parece un locator (por ejemplo IM77 o IM77AJ)"
