# Callsign validation (core/callsign.py).
msgid "The callsign is missing."
msgstr "Falta el indicativo."

msgid ""
"«{call}» contains characters that are not allowed ({chars}). A callsign only "
"has letters, digits and the portable slash."
msgstr ""
"«{call}» contiene caracteres no permitidos ({chars}). Un indicativo solo "
"lleva letras, números y la barra de portable."

msgid "«{call}» does not contain any callsign."
msgstr "«{call}» no contiene ningún indicativo."

msgid "«{call}» is too short to be a callsign."
msgstr "«{call}» es demasiado corto para ser un indicativo."

msgid "«{call}» is too long to be a callsign."
msgstr "«{call}» es demasiado largo para ser un indicativo."

msgid ""
"«{call}» has no digit. Every callsign has a digit that separates the prefix "
"from the suffix, as in EA7WM."
msgstr ""
"«{call}» no lleva ningún número. Todo indicativo tiene un dígito que separa "
"el prefijo del sufijo, como en EA7WM."

msgid ""
"«{call}» does not look like a callsign. Expected a prefix, a digit and a "
"suffix, such as EA7WM or 9A1AA. Add «{marker}» at the end to log it anyway."
msgstr ""
"«{call}» no tiene forma de indicativo. Se espera prefijo, dígito y sufijo, "
"como EA7WM o 9A1AA. Añade «{marker}» al final para registrarlo de todos "
"modos."

