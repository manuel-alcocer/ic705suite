/* Dashboard: applications on the left; rig, scope, settings and station on the right;
   messages below. The window with the keys (Tab) has its border lit. */

#top {
    height: 1fr;
    min-height: 12;
}

#apps-frame {
    width: 1fr;
    height: 1fr;
}

#apps-frame:focus-within,
#controls:focus {
    border: round $accent;
}

#apps {
    height: 1fr;
    border: none;
    background: $surface;
    scrollbar-size-horizontal: 0;
}

#apps > .datatable--header {
    background: $panel;
    text-style: bold;
}

#apps > .datatable--cursor,
#apps > .datatable--hover {
    background: $primary;
    text-style: bold;
}

#side {
    width: 1fr;
    min-width: 58;
    height: 1fr;
}

#rig {
    height: auto;
    padding: 0 1;
    background: $surface;
}

#scope {
    height: 1fr;
    min-height: 6;
}

#controls {
    height: auto;
    background: $surface;
}

#station {
    height: auto;
    max-height: 7;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    padding: 0 1;
    background: $surface;
}

#log {
    height: 8;
    padding: 0 1;
    background: $surface;
}
